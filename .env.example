# ─────────────────────────────────────────────────────────────────────────
# Opsis Concierge v2 — environment variables
# Copy to .env.local for local development. Production values live in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────

# ── Claude ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback is on by default; set to "off" to disable.
CLAUDE_FALLBACKS=
CHAT_ENABLED=true
CHAT_MAX_TURNS=20

# ── Storage (Google Sheets) ───────────────────────────────────────────────
# Either a service account (tighter: it only sees sheets shared with its client_email)…
GOOGLE_SERVICE_ACCOUNT_JSON=
# …or the sheet owner's OAuth refresh token (acts as that Google user, so it can open
# every spreadsheet the user can). The service account wins when both are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
SHEET_ID=
# "memory" = demo data in memory (local dev only, nothing is saved)
STORE=

# ── E-mail ────────────────────────────────────────────────────────────────
# Gmail with an app password (no DNS needed; ~500 mails/day). Wins over Resend when set.
SMTP_USER=
SMTP_PASS=
# defaults: smtp.gmail.com, 465
SMTP_HOST=
SMTP_PORT=
# …or Resend with a verified sending domain
RESEND_API_KEY=
# force one: smtp | resend (empty = SMTP if set, else Resend)
MAIL_TRANSPORT=
# log | sandbox | trial | live  (see src/lib/mail.ts)
MAIL_MODE=log
# With Gmail the address part is replaced by SMTP_USER; the name is kept.
MAIL_FROM=Opsis Dalmatia <concierge@send.opsisdalmatia.com>
MAIL_REPLY_TO=
# sandbox mode: every mail goes here
SANDBOX_TO=
# comma-separated; receives booking/registration notifications and reports
ADMIN_EMAIL=
# partner e-mails or @domains that may receive partner mail in trial mode
MAIL_ALLOWLIST=

# ── URLs & secrets ────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3000
# ≥ 32 random characters (signs chat state, booking drafts and links)
SESSION_SECRET=
# ≥ 16 random characters; Vercel Cron sends it automatically
CRON_SECRET=
ADMIN_USER=admin
# ≥ 12 characters
ADMIN_PASSWORD=

# ── Business / pilot ──────────────────────────────────────────────────────
PILOT_MODE=true
SHOW_DEMO_OFFERS=true
# Landlord share of Opsis commission in %, empty = not shown
LANDLORD_SHARE_PCT=
OUTREACH_ENABLED=false
