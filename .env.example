# ──────────────────────────────────────────────────────────────────────────
# Opsis Dalmatia — environment variables
# Copy to .env.local for dev; set the same in Vercel (Production/Preview/Dev).
# ──────────────────────────────────────────────────────────────────────────

# ── LLM ─────────────────────────────────────────────────────────────────
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# ── Google Sheets ───────────────────────────────────────────────────────
# Service account JSON (one line). Share each sheet with the client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

SHEET_OPERATORS_ID=1xqrBMAkwcLR85cVOH_jSXm-Ew7l9PnTLYoRh0dPRYfg
SHEET_LANDLORDS_ID=1FUIQF1tYJ_mZfHaQOe7i1_hK3iwTMItAAMBHbAsTNbU
SHEET_BOOKINGS_ID=1p5TBmlqpCPlPVFTEuvkYf7afI4-ASZvnGXdXMMcOr6I
SHEET_QUIZ_ID=1dg-1kO_9-hRusY9PvZp9N4s__vImZPLKd23pSGfAv5c
SHEET_BLACKOUTS_ID=1aGLC4P-sGz07V3JCeE7Y9X5BE0-k7ofPZRKa3zOu_NI

# Optional outreach lead sheets
SHEET_OPERATOR_LEADS_ID=
SHEET_LANDLORD_LEADS_ID=

# Optional photo-submissions sheet (defaults to the operators sheet, tab "Photos")
SHEET_OPERATOR_PHOTOS_ID=
SHEET_OPERATOR_PHOTOS_RANGE=Photos!A:Z

# Optional per-sheet ranges
SHEET_OPERATORS_RANGE=A:Z
SHEET_LANDLORDS_RANGE=A:Z
SHEET_BOOKINGS_RANGE=A:Z
SHEET_QUIZ_RANGE=A:Z
SHEET_BLACKOUTS_RANGE=A:Z
SHEET_OPERATOR_LEADS_RANGE=A:Z
SHEET_OPERATOR_LEADS_SENT_RANGE=Sent!A:Z
SHEET_LANDLORD_LEADS_RANGE=A:Z
SHEET_LANDLORD_LEADS_SENT_RANGE=Sent!A:Z

# ── Email (SMTP) ────────────────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_USER=tutafranko@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
